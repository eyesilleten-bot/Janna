# Janna implementation source - never publish
*.py
*.pyc
*.pyo
*.js
*.ts
*.spec
*.iss
*.ps1
*.cmd
*.bat

# Compiled / packaged artifacts are GitHub Release assets, not repo files
*.exe
*.dll
*.zip
*.vsix

# Janna source files are private by default
*.ja
*.janna
*.toml

# Only Janna Frontier source is allowed publicly
!examples/janna_frontier/
!examples/janna_frontier/**
